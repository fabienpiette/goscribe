# Operational mode: all | api | worker
# MODE=all (default): runs HTTP API + worker in one container
# MODE=api: HTTP API only (use with separate worker container)
# MODE=worker: worker only (use with separate API container)
# For split mode, use: docker compose --profile split up
MODE=all

# HTTP port
PORT=8080

# Redis connection URL
# Set automatically when using docker-compose; override for an external Redis instance.
REDIS_URL=redis://redis:6379

# AI providers — at least one key is required
OPENAI_API_KEY=
GEMINI_API_KEY=

# Default provider: openai | gemini
GOSCRIBE_PROVIDER=openai

# Gemini model (only used when provider=gemini)
GEMINI_MODEL=gemini-2.0-flash

# Optional: path to a custom config.yml inside the container for extra post-processing actions
# Mount the file as a volume and set this to its container path.
# GOSCRIBE_CONFIG_FILE=/app/config.yml

# Job result retention in Redis (hours)
RESULT_TTL_HOURS=24

# Maximum audio upload size (MB)
MAX_UPLOAD_MB=100

# Graceful shutdown drain timeout (seconds)
SHUTDOWN_TIMEOUT_SECONDS=30

# Temporary directory for uploaded audio files inside the container
UPLOADS_DIR=/tmp/goscribe-uploads
