# Stage 1: Build (identical to existing Dockerfile)
FROM golang:1.24-alpine AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -ldflags="-s -w" -o goscribe ./cmd/goscribe && \
    go build -ldflags="-s -w" -o server ./cmd/server

# Stage 2: Song-capable runtime with Python + demucs (~800 MB image)
# Uses debian:bookworm-slim instead of alpine because PyTorch (demucs dep)
# requires glibc and cannot be installed cleanly on Alpine.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        ca-certificates \
        python3 \
        python3-pip \
        libsndfile1 \
    && pip3 install --break-system-packages --no-cache-dir \
        torch==2.4.1+cpu torchaudio==2.4.1+cpu \
        --index-url https://download.pytorch.org/whl/cpu \
    && pip3 install --break-system-packages --no-cache-dir "demucs==4.0.1" "soundfile" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r goscribe && useradd -r -g goscribe -m goscribe

WORKDIR /app

COPY --from=builder /build/goscribe /usr/local/bin/goscribe
COPY --from=builder /build/server   /usr/local/bin/server

RUN mkdir -p /tmp/goscribe-uploads && \
    chown goscribe:goscribe /tmp/goscribe-uploads

# Pre-download htdemucs model weights into a fixed cache dir accessible at runtime.
ENV XDG_CACHE_HOME=/opt/demucs-cache
RUN python3 -c "from demucs.pretrained import get_model; get_model('htdemucs')" && \
    chown -R goscribe:goscribe /opt/demucs-cache

USER goscribe

EXPOSE 8080

ENTRYPOINT ["server"]
